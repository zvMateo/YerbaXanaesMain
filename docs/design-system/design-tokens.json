{
  "name": "YerbaXanaes",
  "version": "2.0.0",
  "description": "Paleta agroecológica unificada para tienda y backoffice. Marca: yerba mate de Villa del Rosario.",
  "colors": {
    "brand": {
      "palm": { "hex": "#657F38", "roles": ["primary", "logo-leaf-dark"] },
      "leaf": { "hex": "#9EAB57", "roles": ["illustration", "success-soft", "chart"] },
      "shadow": { "hex": "#212C1B", "roles": ["text", "logo-ink", "borders-strong"] },
      "terra": { "hex": "#D57640", "roles": ["accent-cta", "warning", "sale"] },
      "cream": { "hex": "#FCE0C0", "roles": ["canvas", "logo-field"] }
    },
    "semantic": {
      "background": "#FCE0C0",
      "foreground": "#212C1B",
      "primary": "#657F38",
      "primaryForeground": "#FFFFFF",
      "accent": "#D57640",
      "accentForeground": "#212C1B",
      "muted": "#F4D4AE",
      "mutedForeground": "#3D4A32",
      "border": "#E2C49A",
      "ring": "#657F38",
      "destructive": "#A33B2B",
      "success": "#657F38",
      "warning": "#D57640",
      "info": "#9EAB57"
    },
    "contrast": {
      "shadowOnCream": { "ratio": 11.50, "wcag": "AAA" },
      "whiteOnPalm": { "ratio": 4.52, "wcag": "AA" },
      "whiteOnShadow": { "ratio": 14.58, "wcag": "AAA" },
      "shadowOnLeaf": { "ratio": 5.84, "wcag": "AA" },
      "terraOnCream": { "ratio": 2.55, "wcag": "FAIL-body", "use": "decorative/large only" },
      "palmOnCream": { "ratio": 3.56, "wcag": "AA-large" },
      "leafOnCream": { "ratio": 1.97, "wcag": "FAIL" }
    }
  },
  "typography": {
    "store": {
      "display": { "family": "Playfair Display", "role": "h1-h3, logo-adjacent" },
      "sans": { "family": "Source Sans 3", "role": "ui, body, replaces Inter" }
    },
    "backoffice": {
      "sans": { "family": "Source Sans 3", "role": "all UI, replaces Geist" },
      "mono": { "family": "IBM Plex Mono", "role": "ids, SKUs, logs" }
    },
    "scale": {
      "display": { "size": "3rem", "lineHeight": 1.1, "weight": 600 },
      "h1": { "size": "2.25rem", "lineHeight": 1.15, "weight": 600 },
      "h2": { "size": "1.5rem", "lineHeight": 1.25, "weight": 600 },
      "h3": { "size": "1.25rem", "lineHeight": 1.3, "weight": 600 },
      "body": { "size": "1rem", "lineHeight": 1.6, "weight": 400 },
      "caption": { "size": "0.8125rem", "lineHeight": 1.4, "weight": 400 }
    }
  },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 24, 32, 48, 64] },
  "radius": { "sm": "6px", "md": "8px", "lg": "10px", "xl": "14px", "full": "9999px" },
  "shadows": {
    "sm": "0 1px 2px rgba(33,44,27,0.08)",
    "md": "0 8px 24px rgba(33,44,27,0.12)"
  },
  "icons": {
    "library": "lucide-react",
    "strokeWidth": 1.75,
    "sizes": { "sm": 16, "md": 20, "lg": 24 },
    "doNotUse": ["react-icons", "emoji-as-icon", "mixed-stroke-sets"],
    "brandMark": "custom SVG mate (logo only), never as a UI icon replacement"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms" },
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "notifications": {
    "library": "sonner",
    "store": { "position": "bottom-center", "mobile": "bottom-center", "desktop": "bottom-right" },
    "backoffice": { "position": "top-right" },
    "variants": {
      "success": { "bg": "#657F38", "fg": "#FFFFFF" },
      "error": { "bg": "#A33B2B", "fg": "#FFFFFF" },
      "warning": { "bg": "#FCE0C0", "fg": "#212C1B", "border": "#D57640" },
      "info": { "bg": "#212C1B", "fg": "#FCE0C0" }
    },
    "rules": [
      "Never cream text on terra (2.55:1)",
      "Promise toasts for checkout, save, and stock mutations",
      "Include undo on cart-add",
      "Respect prefers-reduced-motion"
    ]
  },
  "logo": {
    "keep": "circular badge, greek-key ring, mate + bombilla, YERBA XANA / YERBA AGROECOLÓGICA",
    "recolor": {
      "field": "#FCE0C0",
      "ink": "#212C1B",
      "leaves": ["#657F38", "#9EAB57"],
      "accent": "#D57640"
    }
  }
}
