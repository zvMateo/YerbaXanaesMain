# ============================================================
# apps/ecommerce — Variables de Entorno
# ============================================================
# Copiá este archivo a .env.local y completá los valores.
# NUNCA commitees el .env.local real — protegido por .gitignore
#
# DEPLOY: En Vercel → Project Settings → Environment Variables
# ============================================================

# ------------------------------------------------------------
# API — URL del servidor NestJS
# Dev:  http://localhost:3001
# Prod: https://xxx.up.railway.app  (el dominio gratuito que te da Railway)
# API_URL es server-side (usada en next.config.ts rewrites)
# NEXT_PUBLIC_API_URL es client-side (usada en hooks del browser)
# ------------------------------------------------------------
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ------------------------------------------------------------
# SITIO — URL canónica pública
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://yerbaxanaes.com"

# ------------------------------------------------------------
# MERCADOPAGO — Public Key (se expone al browser, es seguro)
# Obtené en: https://www.mercadopago.com.ar/developers/panel
# IMPORTANTE: Usar APP_USR- (producción), NO TEST-
# ------------------------------------------------------------
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-XXXXXXXXXXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ------------------------------------------------------------
# WHATSAPP — Contacto y cotización manual de envíos
# Fuente: lib/brand.ts lee SHIPPING primero, si no WHATSAPP.
# Formato: https://wa.me/549XXXXXXXXXX (podés agregar ?text=...)
# Si no hay ninguna, la tienda oculta el enlace de WhatsApp.
# Nunca hardcodear el número en el código.
# ------------------------------------------------------------
NEXT_PUBLIC_SHIPPING_WHATSAPP_URL="https://wa.me/549XXXXXXXXXX?text=Hola%2C%20necesito%20cotizar%20el%20env%C3%ADo%20de%20mi%20pedido%20de%20YerbaXanaes"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/549XXXXXXXXXX"

# ------------------------------------------------------------
# RETIRO EN LOCAL — dirección de pickup (opcional)
# Default en brand.ts si falta: 25 de Mayo 1572, Villa del Rosario
# ------------------------------------------------------------
NEXT_PUBLIC_STORE_ADDRESS="25 de Mayo 1572, Villa del Rosario"

# ------------------------------------------------------------
# REDES — solo se renderizan iconos si hay URL real
# ------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/yerbaxanaes/"
NEXT_PUBLIC_FACEBOOK_URL=""

# ------------------------------------------------------------
# REVALIDACIÓN ON-DEMAND (Next.js ISR) — server-side
# Secreto que valida el route handler POST /api/revalidate.
# Debe coincidir con el REVALIDATE_SECRET del API. NO usar NEXT_PUBLIC_ (es server-only).
# ------------------------------------------------------------
REVALIDATE_SECRET="un_secreto_compartido_con_el_api"
